{
  "name": "@ayato-san/tooling-configs",
  "type": "module",
  "version": "2.1.1",
  "description": "My custom tooling settings",
  "author": "Ayato-san <ayatosan.pro@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Ayato-san/tooling-configs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayato-san/tooling-configs.git"
  },
  "bugs": {
    "url": "https://github.com/Ayato-san/tooling-configs/issues"
  },
  "keywords": [
    "eslint-config",
    "prettier-config",
    "tsconfig",
    "typescript",
    "config"
  ],
  "exports": {
    "./eslint": {
      "types": "./build/eslint/index.d.ts",
      "import": "./build/eslint/index.js",
      "require": "./build/eslint/index.cjs"
    },
    "./prettier/*": "./build/prettier/*.json",
    "./tsconfig.app": "./tsconfig.app.json",
    "./tsconfig.browser": "./tsconfig.browser.json",
    "./tsconfig.package": "./tsconfig.package.json"
  },
  "files": [
    "./tsconfig.app.json",
    "./tsconfig.base.json",
    "./tsconfig.browser.json",
    "./tsconfig.package.json",
    "build/eslint",
    "build/prettier"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:debug": "eslint . --debug",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run format && npm run lint:fix",
    "build": "tsup",
    "postbuild": "node ./scripts/postbuild.js",
    "prepublishOnly": "npm run build",
    "release": "npx release-it"
  },
  "peerDependencies": {
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-edgejs": "^1.0.7"
  },
  "dependencies": {
    "@adonisjs/eslint-plugin": "^2.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-yml": "^3.3.2",
    "local-pkg": "^1.1.2",
    "typescript-eslint": "^8.59.1"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "prettier": "./build/prettier/default.json",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "web": true
    }
  }
}
